# site/ y build/out/ se generan con build/catalog.py y build/render.py (Vercel y Wrangler lo regeneran antes de publicar)
site/
build/out/
.vercel/
__pycache__/
*.pyc
.DS_Store
.wrangler/
NOTA_PARA_JPTER78.md
.venv/
.cache/
simulator/results/fixed_group/builds/screen_chunks/
.claude/
# entradas de pokesim de las fases 2 y 3: se regeneran con --sim
simulator/results/fase2/*_only.txt
simulator/results/fase3/*_only.txt

# Reproducible laboratory/ranking caches and generated diagnostic artifacts
simulator/runpod-ranking/*
!simulator/runpod-ranking/full/
simulator/runpod-ranking/full/*
!simulator/runpod-ranking/full/sim-results.json.gz
!simulator/runpod-ranking/full/SHA256SUMS
!simulator/runpod-ranking/full/README.md
!simulator/runpod-ranking/full/manifest.runtime.json
!simulator/runpod-ranking/full/runner.log
!simulator/runpod-ranking/full/candidates.json.gz
